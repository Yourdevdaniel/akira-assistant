+def _clean_preview(text: str, limit: int = 150) -> str:
+    """Strip HTML, links and invisible padding from an email body preview.
+
+    The raw bodies are fed to small local models, which otherwise read
+    ``<!--[if mso]>`` blocks and tracking URLs as if they were content.
+    """
+    text = _HTML_COMMENT_RE.sub(" ", text)
+    text = _HTML_TAG_RE.sub(" ", text)
+    text = _URL_RE.sub(" ", text)
+    text = _INVISIBLE_RE.sub("", text)
+    text = " ".join(text.split())
+    if len(text) > limit:
+        text = text[:limit].rsplit(" ", 1)[0] + "…"
+    return text
+
+
+def _sender_name(author: str) -> str:
+    """``"Acme <no-reply@example.com>"`` -> ``"Acme"``; bare addresses pass through."""
+    match = _SENDER_NAME_RE.match(author)
+    return match.group(1).strip() if match else author
+
+
+def _collapse_duplicate_emails(docs: List[Document]) -> List[Document]:
+    """Merge emails with the same sender, subject and preview into the first one.
+
+    The subject gets an ``(xN)`` suffix, so the briefing says it arrived N
+    times instead of repeating it. The preview is part of the key because
+    notifications reuse one subject for different events (GitHub sends the
+    same "OAuth application added" subject for each app). The merged copies'
+    ids are dropped: only callers that never act on individual emails should
+    ask for this.
+    """
+    counts: Dict[tuple, int] = {}
+    firsts: Dict[tuple, Document] = {}
+    for doc in docs:
+        key = (doc.author, doc.title, _clean_preview(doc.content or ""))
+        counts[key] = counts.get(key, 0) + 1
+        firsts.setdefault(key, doc)
+    return [
+        replace(doc, title=f"{doc.title} (x{counts[key]})") if counts[key] > 1 else doc
+        for key, doc in firsts.items()
+    ]
+
