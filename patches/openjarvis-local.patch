+            # PTB awaits every callback: a plain function runs and then fails
+            # with "NoneType can't be used in 'await' expression".
+            async def _handle_msg(update, context):
+                msg = update.message
+                if msg is None:
+                    return
+                cm = ChannelMessage(
+                    channel="telegram",
+                    sender=str(msg.from_user.id) if msg.from_user else "",
+                    content=msg.text or "",
+                    message_id=str(msg.message_id),
+                    conversation_id=str(msg.chat.id),
+                )
+                if _allowed(cm.conversation_id):
+                    _dispatch(cm)
+
+            async def _handle_voice(update, context):
+                """Hand voice notes and audio files over as bytes.
+
+                Handlers get ``metadata["audio"]`` and transcribe it themselves:
+                transcription takes seconds and would stall this event loop.
+                """
+                msg = update.message
+                if msg is None or not _allowed(str(msg.chat.id)):
+                    return
+                media = msg.voice or msg.audio
+                telegram_file = await media.get_file()
+                audio = bytes(await telegram_file.download_as_bytearray())
+                # Voice notes are always Ogg/Opus and have no file name.
+                suffix = os.path.splitext(getattr(media, "file_name", None) or "")[1]
+                _dispatch(
+                    ChannelMessage(
+                        channel="telegram",
+                        sender=str(msg.from_user.id) if msg.from_user else "",
+                        content=msg.caption or "",
+                        message_id=str(msg.message_id),
+                        conversation_id=str(msg.chat.id),
+                        metadata={
+                            "audio": audio,
+                            "audio_format": suffix.lstrip(".") or "ogg",
+                        },
+                    )
+                )
+
             app.add_handler(MessageHandler(filters.TEXT, _handle_msg))
+            app.add_handler(
+                MessageHandler(filters.VOICE | filters.AUDIO, _handle_voice)
+            )
             loop.run_until_complete(self._run_polling_lifecycle(app, async_stop_event))
         except Exception:
             logger.debug("Telegram poll loop error", exc_info=True)
