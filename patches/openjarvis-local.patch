+class TestVoiceMessages:
+    """Voice notes reach handlers as audio bytes; unlisted chats never download."""
+
+    @staticmethod
+    def _registered_handlers(ch: TelegramChannel) -> dict:
+        """Run the real _poll_loop against a fake PTB; return its callbacks."""
+        registered: dict = {}
+
+        class FakeApp:
+            def add_handler(self, handler):
+                flt, callback = handler
+                registered[flt] = callback
+
+        class FakeBuilder:
+            def token(self, token):
+                return self
+
+            def build(self):
+                return FakeApp()
+
+        voice = MagicMock()
+        voice.__or__.return_value = "voice"
+        telegram_ext = SimpleNamespace(
+            ApplicationBuilder=FakeBuilder,
+            MessageHandler=lambda flt, callback: (flt, callback),
+            filters=SimpleNamespace(TEXT="text", VOICE=voice, AUDIO=MagicMock()),
+        )
+
+        async def no_polling(app, stop_event):
+            return None
+
+        with (
+            patch.dict(
+                sys.modules,
+                {
+                    "telegram": SimpleNamespace(ext=telegram_ext),
+                    "telegram.ext": telegram_ext,
+                },
+            ),
+            patch.object(ch, "_run_polling_lifecycle", new=no_polling),
+        ):
+            ch._poll_loop()
+        return registered
+
+    @staticmethod
+    def _voice_update(chat_id: int):
+        downloads: list = []
+
+        class FakeFile:
+            async def download_as_bytearray(self):
+                downloads.append(chat_id)
+                return bytearray(b"OggS-fake")
+
+        async def get_file():
+            return FakeFile()
+
+        msg = SimpleNamespace(
+            chat=SimpleNamespace(id=chat_id),
+            from_user=SimpleNamespace(id=chat_id),
+            message_id=9,
+            caption=None,
+            voice=SimpleNamespace(get_file=get_file),
+            audio=None,
+        )
+        return SimpleNamespace(message=msg), downloads
+
+    def test_voice_note_reaches_handlers_as_audio(self):
+        ch = TelegramChannel(bot_token="tok", allowed_chat_ids="111")
+        received: list = []
+        ch.on_message(received.append)
+        update, _ = self._voice_update(111)
+
+        asyncio.run(self._registered_handlers(ch)["voice"](update, None))
+
+        assert len(received) == 1
+        assert received[0].content == ""
+        assert received[0].metadata == {"audio": b"OggS-fake", "audio_format": "ogg"}
+
+    def test_voice_from_unlisted_chat_is_not_downloaded(self):
+        ch = TelegramChannel(bot_token="tok", allowed_chat_ids="111")
+        received: list = []
+        ch.on_message(received.append)
+        update, downloads = self._voice_update(999)
+
+        asyncio.run(self._registered_handlers(ch)["voice"](update, None))
+
+        assert received == []
+        assert downloads == []
+
+    def test_text_callback_is_a_coroutine(self):
+        """PTB awaits callbacks; a plain function raised TypeError after running."""
+        ch = TelegramChannel(bot_token="tok")
+        received: list = []
+        ch.on_message(received.append)
+        msg = SimpleNamespace(
+            chat=SimpleNamespace(id=5), from_user=None, message_id=1, text="oi"
+        )
+
+        asyncio.run(
+            self._registered_handlers(ch)["text"](SimpleNamespace(message=msg), None)
+        )
+
+        assert received[0].content == "oi"
+
