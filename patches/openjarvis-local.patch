+def _spoken_money(text: str) -> str:
+    """``R$ 55,00`` -> ``55 reais``; ``$250`` -> ``250 dólares``.
+
+    The synthesizer reads the currency symbol literally.
+    """
+
+    def speak(match: re.Match) -> str:
+        real = match.group(1) == "R"
+        thousands, decimal = (".", ",") if real else (",", ".")
+        whole, _, cents = match.group(2).replace(thousands, "").partition(decimal)
+        if whole == "1":
+            unit = "real" if real else "dólar"
+        else:
+            unit = "reais" if real else "dólares"
+        spoken = f"{whole} {unit}"
+        cents = cents.ljust(2, "0")[:2]
+        if cents.strip("0"):
+            spoken += f" e {int(cents)} centavos"
+        return spoken
+
+    return _MONEY_RE.sub(speak, text)
+
