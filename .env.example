# Copy to .env and fill in. .env is ignored by git; never commit it.
# iniciar-akira.cmd and resumo-diario.cmd load this file. The Python runners
# read these variables first and fall back to [channel.telegram] in
# ~/.openjarvis/config.toml when they are empty.

# Telegram bot token.
# How to get it: in Telegram, open @BotFather, send /newbot, pick a name and a
# username ending in "bot". BotFather replies with the token.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs allowed to talk to the bot. Messages from any other
# chat are ignored, and the morning digest goes to the first ID.
# How to get yours: send any message to your new bot, then open
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# in a browser and copy result[0].message.chat.id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: path to the OpenJarvis checkout (default: ./openjarvis).
# OPENJARVIS_DIR=

# Optional: context window the task classifier asks Ollama for. Keep it equal
# to what OpenJarvis uses, or Ollama reloads the model on every switch.
# JARVIS_NUM_CTX=16384

# Google OAuth client (not an environment variable: a file).
# How to get it:
#   1. console.cloud.google.com: create a project and enable the Gmail API and
#      the Google Calendar API (Drive and Tasks are optional).
#   2. Google Auth Platform: configure the consent screen as "External", keep it
#      in Testing and add your own Google account as a test user.
#   3. Clients > Create client > "Desktop app". Download the JSON.
#   4. Save it as ~/.openjarvis/connectors/google.json (outside this repo) and
#      run: uv run --project openjarvis python runner/conectar_google.py
# In Testing mode the refresh token expires after 7 days; run the script again.
